---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<!-- HERO -->
		<section class="hero">
			<div class="hero-bg"></div>
			<div class="hero-content">
				<div class="hero-tag">INGÉNIEUR_LOGICIEL.exe</div>
				<div class="hero-name">
					<div class="line1">YANN</div>
					<div class="line2">COURTEMANCHE</div>
				</div>
				<div class="hero-subtitle">// FULL-STACK · SYSTÈMES · ARCHITECTURE</div>
				<p class="hero-desc">
					Je construis des <strong>systèmes robustes</strong> à l'intersection du code et du design.
					Spécialisé en architecture distribuée, APIs haute-performance et interfaces critiques.
				</p>
				<div class="cta-group">
					<a href="/blog" class="btn-primary">VOIR_LE_BLOG ›</a>
					<a href="/about" class="btn-ghost">À PROPOS</a>
				</div>
			</div>
		</section>

		<!-- STATS -->
		<div class="stats-bar">
			<div class="stat">
				<div class="stat-num">8<span class="blink">_</span></div>
				<div class="stat-label">ans d'expérience</div>
			</div>
			<div class="stat">
				<div class="stat-num">40+</div>
				<div class="stat-label">projets livrés</div>
			</div>
			<div class="stat">
				<div class="stat-num">12</div>
				<div class="stat-label">clients actifs</div>
			</div>
			<div class="stat">
				<div class="stat-num">99.9%</div>
				<div class="stat-label">uptime garanti</div>
			</div>
		</div>

		<!-- SKILLS -->
		<section class="section" id="skills">
			<div class="section-header">
				<span class="section-num">01</span>
				<h2 class="section-title">COMPÉTENCES <span>TECHNIQUES</span></h2>
				<div class="section-line"></div>
			</div>
			<div class="skills-grid">
				<div class="skill-card">
					<div class="skill-name">Backend Systems</div>
					<div class="skill-tags">
						<span class="tag">Python</span>
						<span class="tag">Node.js</span>
						<span class="tag">Go</span>
						<span class="tag">Rust</span>
					</div>
					<div class="skill-bar-wrap"><div class="skill-bar" style="width:92%"></div></div>
				</div>
				<div class="skill-card">
					<div class="skill-name">Cloud & DevOps</div>
					<div class="skill-tags">
						<span class="tag lilas">AWS</span>
						<span class="tag lilas">Docker</span>
						<span class="tag lilas">K8s</span>
						<span class="tag lilas">Terraform</span>
					</div>
					<div class="skill-bar-wrap"><div class="skill-bar" style="width:85%"></div></div>
				</div>
				<div class="skill-card">
					<div class="skill-name">Frontend</div>
					<div class="skill-tags">
						<span class="tag">React</span>
						<span class="tag">TypeScript</span>
						<span class="tag">Astro</span>
					</div>
					<div class="skill-bar-wrap"><div class="skill-bar" style="width:78%"></div></div>
				</div>
				<div class="skill-card">
					<div class="skill-name">Data & IA</div>
					<div class="skill-tags">
						<span class="tag rose">PostgreSQL</span>
						<span class="tag rose">Redis</span>
						<span class="tag rose">ML Ops</span>
					</div>
					<div class="skill-bar-wrap"><div class="skill-bar" style="width:80%"></div></div>
				</div>
				<div class="skill-card">
					<div class="skill-name">Sécurité</div>
					<div class="skill-tags">
						<span class="tag lilas">Pentest</span>
						<span class="tag lilas">OAuth2</span>
						<span class="tag lilas">Zero Trust</span>
					</div>
					<div class="skill-bar-wrap"><div class="skill-bar" style="width:72%"></div></div>
				</div>
				<div class="skill-card">
					<div class="skill-name">Architecture</div>
					<div class="skill-tags">
						<span class="tag">Microservices</span>
						<span class="tag">Event Driven</span>
						<span class="tag">DDD</span>
					</div>
					<div class="skill-bar-wrap"><div class="skill-bar" style="width:88%"></div></div>
				</div>
			</div>
		</section>

		<!-- HUD -->
		<div class="hud-block">
			<div class="hud-inner">
				<div class="hud-item">
					<span class="hud-label">// disponibilité</span>
					<span class="hud-val">OPEN<span class="blink">_</span></span>
					<span class="hud-sub">Missions freelance · CDI</span>
				</div>
				<div class="hud-item">
					<span class="hud-label">// localisation</span>
					<span class="hud-val">PARIS</span>
					<span class="hud-sub">Remote accepted · EU</span>
				</div>
				<div class="hud-item">
					<span class="hud-label">// blog</span>
					<span class="hud-val">ACTIF<span class="blink">_</span></span>
					<span class="hud-sub">Réflexions & projets perso</span>
				</div>
			</div>
		</div>

		<Footer />
	</body>
</html>

<style>
	/* HERO */
	.hero {
		min-height: 100vh;
		display: flex;
		align-items: center;
		padding: 0 4rem;
		padding-top: 60px;
		position: relative;
		overflow: hidden;
	}
	.hero-bg {
		position: absolute;
		right: 0; top: 0;
		width: 50%; height: 100%;
		background:
			radial-gradient(ellipse at 70% 30%, rgba(176,96,144,0.18) 0%, transparent 55%),
			radial-gradient(ellipse at 30% 80%, rgba(123,106,173,0.14) 0%, transparent 50%);
		pointer-events: none;
	}
	.hero-content {
		position: relative;
		z-index: 2;
		max-width: 620px;
	}
	.hero-tag {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.68rem;
		letter-spacing: 4px;
		color: var(--jaune);
		margin-bottom: 1.5rem;
		display: flex;
		align-items: center;
		gap: 1rem;
		animation: fadeUp 0.8s ease 0.1s both;
	}
	.hero-tag::before {
		content: '';
		width: 36px; height: 1px;
		background: var(--jaune);
		box-shadow: 0 0 8px var(--jaune);
	}
	.hero-name {
		font-family: 'Orbitron', monospace;
		font-size: clamp(2.4rem, 5vw, 4rem);
		font-weight: 900;
		line-height: 1;
		margin-bottom: 0.6rem;
		letter-spacing: 2px;
		animation: fadeUp 0.8s ease 0.25s both;
	}
	.line1 { color: #e8d8f0; }
	.line2 {
		color: transparent;
		-webkit-text-stroke: 1.5px var(--rose2);
	}
	.hero-subtitle {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.78rem;
		color: var(--lilas);
		letter-spacing: 3px;
		margin-bottom: 2rem;
		margin-top: 0.5rem;
		animation: fadeUp 0.8s ease 0.35s both;
	}
	.hero-desc {
		font-size: 1.05rem;
		color: var(--txt2);
		max-width: 480px;
		line-height: 1.85;
		margin-bottom: 2.5rem;
		font-weight: 300;
		animation: fadeUp 0.8s ease 0.5s both;
	}
	.hero-desc strong { color: var(--txt); font-weight: 600; }
	.cta-group {
		display: flex;
		gap: 1.2rem;
		flex-wrap: wrap;
		animation: fadeUp 0.8s ease 0.65s both;
	}
	.btn-primary {
		display: inline-flex;
		align-items: center;
		padding: 0.9rem 2.2rem;
		background: var(--jaune);
		color: #1a0d18;
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.72rem;
		letter-spacing: 2px;
		text-decoration: none;
		font-weight: 700;
		clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
		transition: all 0.3s;
	}
	.btn-primary:hover {
		background: var(--jaune2);
		box-shadow: 0 0 28px rgba(240,208,32,0.4);
		color: #1a0d18;
		text-shadow: none;
	}
	.btn-ghost {
		display: inline-flex;
		align-items: center;
		padding: 0.9rem 2.2rem;
		background: transparent;
		color: var(--rose2);
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.72rem;
		letter-spacing: 2px;
		text-decoration: none;
		border: 1px solid rgba(232,113,138,0.35);
		transition: all 0.3s;
	}
	.btn-ghost:hover {
		border-color: var(--rose2);
		background: rgba(232,113,138,0.07);
		color: var(--rose2);
		text-shadow: none;
	}

	/* STATS */
	.stats-bar {
		position: relative; z-index: 2;
		background: var(--bg2);
		border-top: 1px solid rgba(176,96,144,0.15);
		border-bottom: 1px solid rgba(176,96,144,0.15);
		padding: 2rem 4rem;
		display: flex;
		justify-content: space-around;
		gap: 2rem;
		flex-wrap: wrap;
	}
	.stat { text-align: center; }
	.stat-num {
		font-family: 'Orbitron', monospace;
		font-size: 2rem;
		font-weight: 700;
		color: var(--jaune);
		text-shadow: 0 0 18px rgba(240,208,32,0.3);
	}
	.stat-label {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.62rem;
		letter-spacing: 2px;
		color: var(--txt2);
		margin-top: 0.3rem;
		text-transform: uppercase;
	}
	.blink { animation: blink 1s step-end infinite; }
	@keyframes blink { 50% { opacity: 0; } }

	/* SECTION */
	.section { padding: 5rem 4rem; position: relative; z-index: 1; }
	.section-header {
		margin-bottom: 3rem;
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.section-num {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.62rem;
		letter-spacing: 3px;
		color: var(--rose);
	}
	.section-title {
		font-family: 'Orbitron', monospace;
		font-size: clamp(1.1rem, 2vw, 1.6rem);
		font-weight: 700;
		letter-spacing: 2px;
		color: #e8d8f0;
		margin: 0;
	}
	.section-title span { color: var(--jaune); }
	.section-line {
		flex: 1; height: 1px;
		background: linear-gradient(90deg, rgba(176,96,144,0.35), transparent);
	}

	/* SKILLS */
	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.4rem;
	}
	.skill-card {
		background: var(--bg2);
		border: 1px solid rgba(176,96,144,0.14);
		padding: 1.6rem;
		position: relative;
		overflow: hidden;
		transition: border-color 0.3s, transform 0.3s;
		clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 0 100%);
	}
	.skill-card::before {
		content: '';
		position: absolute;
		top: 0; left: 0;
		width: 100%; height: 2px;
		background: linear-gradient(90deg, var(--jaune), transparent);
		opacity: 0;
		transition: opacity 0.3s;
	}
	.skill-card:hover { border-color: rgba(240,208,32,0.25); transform: translateY(-3px); }
	.skill-card:hover::before { opacity: 1; }
	.skill-name {
		font-family: 'Rajdhani', sans-serif;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 2px;
		color: #e8d8f0;
		margin-bottom: 0.8rem;
		text-transform: uppercase;
	}
	.skill-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1rem;
	}
	.tag.lilas {
		border-color: rgba(155,143,196,0.3);
		color: var(--lilas);
		background: rgba(155,143,196,0.05);
	}
	.tag.rose {
		border-color: rgba(232,113,138,0.3);
		color: var(--rose2);
		background: rgba(232,113,138,0.05);
	}
	.skill-bar-wrap { background: rgba(255,255,255,0.06); height: 2px; }
	.skill-bar {
		height: 2px;
		background: linear-gradient(90deg, var(--jaune), var(--rose2));
		box-shadow: 0 0 8px rgba(240,208,32,0.35);
	}

	/* HUD */
	.hud-block {
		position: relative; z-index: 1;
		padding: 0 4rem 4rem;
	}
	.hud-inner {
		border: 1px solid rgba(176,96,144,0.18);
		background: var(--bg2);
		padding: 2rem 2.5rem;
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 2rem;
		clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 24px 100%, 0 calc(100% - 24px));
	}
	.hud-item { display: flex; flex-direction: column; gap: 0.4rem; }
	.hud-label {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.6rem;
		letter-spacing: 3px;
		color: var(--rose);
		text-transform: uppercase;
	}
	.hud-val {
		font-family: 'Orbitron', monospace;
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--jaune);
	}
	.hud-sub { font-size: 0.85rem; color: var(--txt2); }

	@keyframes fadeUp {
		from { opacity: 0; transform: translateY(20px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@media (max-width: 768px) {
		.hero { padding: 5rem 1.5rem 3rem; min-height: auto; }
		.stats-bar { padding: 1.5rem; }
		.section { padding: 3rem 1.5rem; }
		.hud-block { padding: 0 1.5rem 3rem; }
		.hud-inner { grid-template-columns: 1fr; }
	}
</style>