---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="blog-header">
				<div class="section-header">
					<span class="section-num">//</span>
					<h1 class="section-title">TRANSMISSIONS <span>RÉCENTES</span></h1>
					<div class="section-line"></div>
				</div>
				<p class="blog-intro">Réflexions personnelles, avancement de projets, notes techniques.</p>
			</div>

			{posts.length === 0 && (
				<div class="empty">
					<span class="empty-tag">// AUCUN_ARTICLE</span>
					<p>Les premières transmissions arrivent bientôt.</p>
				</div>
			)}

			<ul class="posts-list">
				{posts.map((post) => (
					<li class="post-item">
						<a href={`/blog/${post.id}/`} class="post-link">
							<div class="post-meta">
								<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
							</div>
							<h2 class="post-title">{post.data.title}</h2>
							{post.data.description && (
								<p class="post-desc">{post.data.description}</p>
							)}
							<span class="post-cta">LIRE ›</span>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		padding-top: 5rem;
	}
	.blog-header {
		margin-bottom: 3rem;
	}
	.section-header {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 1rem;
	}
	.section-num {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.62rem;
		letter-spacing: 3px;
		color: var(--rose);
	}
	.section-title {
		font-family: 'Orbitron', monospace;
		font-size: clamp(1.1rem, 2.5vw, 1.6rem);
		font-weight: 700;
		letter-spacing: 2px;
		color: #e8d8f0;
		margin: 0;
	}
	.section-title span { color: var(--jaune); }
	.section-line {
		flex: 1;
		height: 1px;
		background: linear-gradient(90deg, rgba(176,96,144,0.35), transparent);
	}
	.blog-intro {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.72rem;
		letter-spacing: 1px;
		color: var(--txt2);
		margin: 0;
	}

	/* POSTS LIST */
	.posts-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1px;
	}
	.post-item {
		border: 1px solid rgba(176,96,144,0.1);
		background: var(--bg2);
		transition: border-color 0.3s, transform 0.2s;
		position: relative;
		overflow: hidden;
	}
	.post-item::before {
		content: '';
		position: absolute;
		left: 0; top: 0; bottom: 0;
		width: 2px;
		background: var(--jaune);
		transform: scaleY(0);
		transition: transform 0.3s;
	}
	.post-item:hover {
		border-color: rgba(240,208,32,0.2);
		transform: translateX(4px);
	}
	.post-item:hover::before { transform: scaleY(1); }

	.post-link {
		display: block;
		padding: 1.8rem 2rem;
		text-decoration: none;
		color: inherit;
	}
	.post-link:hover { color: inherit; text-shadow: none; }

	.post-meta {
		margin-bottom: 0.6rem;
	}
	.post-date {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.62rem;
		letter-spacing: 3px;
		color: var(--rose);
		text-transform: uppercase;
	}
	.post-title {
		font-family: 'Orbitron', monospace;
		font-size: clamp(1rem, 2vw, 1.3rem);
		font-weight: 700;
		color: #e8d8f0;
		margin: 0 0 0.6rem;
		letter-spacing: 1px;
		line-height: 1.3;
		transition: color 0.3s;
	}
	.post-item:hover .post-title { color: var(--jaune); }

	.post-desc {
		font-size: 0.9rem;
		color: var(--txt2);
		line-height: 1.7;
		margin: 0 0 1rem;
	}
	.post-cta {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.62rem;
		letter-spacing: 3px;
		color: var(--txt2);
		text-transform: uppercase;
		transition: color 0.3s;
	}
	.post-item:hover .post-cta { color: var(--jaune); }

	/* EMPTY */
	.empty {
		text-align: center;
		padding: 4rem 0;
	}
	.empty-tag {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.7rem;
		letter-spacing: 3px;
		color: var(--rose);
		display: block;
		margin-bottom: 1rem;
	}
	.empty p { color: var(--txt2); }

	@media (max-width: 720px) {
		.post-link { padding: 1.2rem 1rem; }
	}
</style>