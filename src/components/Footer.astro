---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-logo">YC<span>.</span>FR</div>
		<div class="footer-copy">
			&copy; {today.getFullYear()} Y. Courtemanche — Tous droits réservés — Paris, FR
		</div>
		<div class="social-links">
			<a href="https://github.com/courtemancheyann31-web" target="_blank" aria-label="GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
					<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
				</svg>
			</a>
		</div>
	</div>
</footer>

<style>
	footer {
		position: relative;
		z-index: 1;
		border-top: 1px solid rgba(176, 96, 144, 0.14);
		background: var(--bg2);
		padding: 1.8rem 4rem;
	}
	.footer-inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.footer-logo {
		font-family: 'Orbitron', monospace;
		font-size: 1rem;
		font-weight: 900;
		color: var(--jaune);
		letter-spacing: 3px;
		text-shadow: 0 0 12px rgba(240, 208, 32, 0.3);
	}
	.footer-logo span { color: var(--rose2); }
	.footer-copy {
		font-family: 'Share Tech Mono', monospace;
		font-size: 0.6rem;
		letter-spacing: 2px;
		color: var(--txt2);
		text-transform: uppercase;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}
	.social-links a {
		color: var(--txt2);
		transition: color 0.3s;
		text-decoration: none;
	}
	.social-links a:hover {
		color: var(--jaune);
		text-shadow: none;
	}

	@media (max-width: 720px) {
		footer { padding: 1.5rem; }
		.footer-inner { flex-direction: column; text-align: center; }
	}
</style>